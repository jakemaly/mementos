# ==============================================================================
# second-brain Environment Configuration Template
# Copy this file to '.env' (in the root or individual app/sidecar directories)
# and populate with your credentials.
# ==============================================================================

# LLM Configuration (OpenAI-compatible Endpoint)
# Required for expected-response sketch generation & LightRAG graph synthesis
OPENAI_API_KEY="your-openai-compatible-api-key-here"
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_MODEL_NAME="gpt-4o-mini"

# Tavily Search API Key
# Required for SIRA Deep Research parallel web crawling
TAVILY_API_KEY="your-tavily-api-key-here"

# Vector Database Settings
# Optional: Defaults to http://localhost:6333 if left blank
QDRANT_URL="http://localhost:6333"
